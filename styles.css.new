body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #f3f7ff;
    min-height: 100vh;
    background:
        radial-gradient(circle at top left, rgba(56, 189, 248, 0.28), transparent 24%),
        radial-gradient(circle at 85% 10%, rgba(129, 140, 248, 0.24), transparent 20%),
        linear-gradient(135deg, #040816 0%, #071124 40%, #0d172f 100%);
    overflow-x: hidden;
    scroll-behavior: smooth;
}

body::before,
body::after {
    content: '';
    position: fixed;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.35;
    pointer-events: none;
    z-index: -1;
    animation: drift 10s ease-in-out infinite alternate;
}

body::before {
    width: 260px;
    height: 260px;
    top: -70px;
    left: -70px;
    background: rgba(14, 165, 233, 0.35);
}

body::after {
    width: 320px;
    height: 320px;
    bottom: -90px;
    right: -90px;
    background: rgba(129, 140, 248, 0.32);
    animation-duration: 12s;
}

.container {
    max-width: 1220px;
    margin: 0 auto;
    padding: 24px;
    position: relative;
}

.site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    padding: 16px 20px;
    border-radius: 24px;
    background: rgba(8, 14, 28, 0.74);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 18px 50px rgba(2, 8, 23, 0.3);
    position: sticky;
    top: 18px;
    z-index: 10;
}

.site-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
}

.site-brand__mark {
    width: 44px;
    height: 44px;
    border-radius: 16px;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    display: grid;
    place-items: center;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 12px 30px rgba(56, 189, 248, 0.25);
}

.site-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #f8fbff;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 12px;
}

.nav-link {
    color: #dbeafe;
    text-decoration: none;
    font-weight: 600;
    transition: color 180ms ease, transform 180ms ease, background-color 180ms ease;
}

.nav-link:hover {
    color: #ffffff;
    transform: translateY(-1px);
}

.nav-link--button {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.2);
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.16), rgba(129, 140, 248, 0.18));
    color: #f8fbff;
}

.card {
    background: rgba(8, 15, 30, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 22px 60px rgba(2, 8, 23, 0.28);
    animation: fadeUp 220ms ease-out;
    backdrop-filter: blur(16px);
}

.hero {
    padding: 32px;
    margin-bottom: 24px;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(129, 140, 248, 0.14));
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.15);
}

.hero::before,
.hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
}

.hero::before {
    width: 220px;
    height: 220px;
    top: -80px;
    right: -60px;
    background: rgba(255,255,255,0.18);
    filter: blur(2px);
}

.hero::after {
    width: 180px;
    height: 180px;
    bottom: -70px;
    left: -40px;
    background: rgba(56, 189, 248, 0.2);
}

.hero h1 {
    margin: 0 0 12px;
    font-size: clamp(2.2rem, 3vw, 3.25rem);
    line-height: 1.05;
    color: #ffffff;
}

.hero p {
    max-width: 700px;
    margin: 0;
    font-size: 1.03rem;
    color: #cbd5e1;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
}

.book-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(145deg, rgba(10, 17, 35, 0.95), rgba(8, 15, 32, 0.8));
    min-height: 280px;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
    box-shadow: 0 10px 25px rgba(2, 8, 23, 0.22);
}

.book-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.35);
}

.book-cover-preview {
    display: grid;
    place-items: center;
    height: 112px;
    border-radius: 18px;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
    color: white;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);
}

.book-cover-image {
    width: 100%;
    height: 170px;
    object-fit: contain;
    object-position: center;
    border-radius: 18px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
}

.book-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.95rem;
    color: #94a3b8;
}

.book-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0;
    color: #f8fafc;
}

.book-card__description {
    color: #cbd5e1;
    flex: 1;
}

.edit-details {
    margin-bottom: 12px;
}

.edit-details summary {
    cursor: pointer;
    font-weight: 700;
    color: #7dd3fc;
    margin-bottom: 10px;
}

.edit-form {
    padding: 12px;
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    border: none;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease, background 180ms ease;
}

.button:hover {
    transform: translateY(-1px);
}

.button--primary {
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: white;
    box-shadow: 0 10px 24px rgba(56, 189, 248, 0.18);
}

.button--secondary {
    color: #e2e8f0;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
}

.form-card {
    max-width: 560px;
    margin: 0 auto;
    padding: 28px;
    position: relative;
    overflow: hidden;
}

.form-card::before {
    content: '';
    position: absolute;
    inset: -40px auto auto -40px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56,189,248,0.16), transparent 70%);
    pointer-events: none;
}

.form-card__header {
    margin-bottom: 20px;
}

.form-card__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.14);
    color: #7dd3fc;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.form-card__header h1 {
    margin: 0 0 6px;
    font-size: clamp(1.55rem, 2vw, 2rem);
    color: #ffffff;
}

.form-card__intro {
    margin: 0;
    color: #94a3b8;
    line-height: 1.6;
}

.form-field {
    display: grid;
    gap: 8px;
    margin-bottom: 18px;
}

.form-field label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #e2e8f0;
}

.form-field input,
.form-field select,
.form-field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    font-size: 1rem;
    color: #f8fafc;
    box-sizing: border-box;
}

.form-field textarea {
    min-height: 96px;
    resize: vertical;
}

.form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 8px;
}

.form-hint {
    margin-top: 16px;
    font-size: 0.95rem;
    color: #94a3b8;
}

.alert {
    padding: 16px 18px;
    border-radius: 18px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.24);
    color: #bae6fd;
    margin-bottom: 24px;
}

.footer {
    margin-top: 40px;
    color: #94a3b8;
    font-size: 0.95rem;
    text-align: center;
}

.site-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
}

.hero-home {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr;
    gap: 24px;
    align-items: center;
}

.hero-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 9999px;
    background: rgba(255,255,255,0.1);
    color: #7dd3fc;
    font-weight: 700;
    font-size: 0.9rem;
    margin-bottom: 16px;
}

.search-shell {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.search-shell input {
    flex: 1;
    min-width: 220px;
    padding: 14px 16px;
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.06);
    color: #f8fafc;
}

.homepage-actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    flex-wrap: wrap;
}

.hero__stats {
    display: grid;
    gap: 14px;
}

.stat-card {
    padding: 18px;
    border-radius: 20px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
}

.stat-card strong {
    display: block;
    font-size: 1.35rem;
    color: #7dd3fc;
}

.stat-card span {
    color: #cbd5e1;
}

.results-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    margin-bottom: 18px;
}

.results-header h2 {
    margin: 0;
    color: #fff;
}

.results-header p {
    margin: 0;
    color: #94a3b8;
}

.empty-state {
    padding: 24px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(56,189,248,0.09));
    border: 1px dashed rgba(125, 211, 252, 0.35);
    color: #dbeafe;
    animation: fadeUp 220ms ease-out;
}

.empty-state a {
    color: #7dd3fc;
    font-weight: 600;
}

.viewer-shell {
    padding: 0;
    overflow: hidden;
}

.viewer-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
}

.viewer-toolbar__meta {
    display: grid;
    gap: 3px;
}

.viewer-toolbar__meta strong {
    font-size: 1rem;
    color: #f8fafc;
}

.viewer-toolbar__meta span {
    color: #94a3b8;
    font-size: 0.92rem;
}

.viewer-toolbar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.viewer-frame {
    width: 100%;
    height: calc(100vh - 180px);
    border: 0;
    background: rgba(255,255,255,0.03);
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes drift {
    from {
        transform: translate3d(0, 0, 0) scale(1);
    }
    to {
        transform: translate3d(20px, 24px, 0) scale(1.06);
    }
}

@media (max-width: 860px) {
    .hero-home {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .site-header {
        flex-direction: column;
        align-items: stretch;
    }

    .hero {
        text-align: center;
    }

    .search-shell {
        flex-direction: column;
    }

    .results-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .form-card {
        padding: 20px;
    }

    .viewer-toolbar {
        flex-direction: column;
        align-items: flex-start;
    }

    .viewer-frame {
        height: calc(100vh - 220px);
    }
}
